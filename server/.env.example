GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret_from_google_cloud
CALLBACK_URL=http://localhost:5000/auth/google/callback

# Frontend URL used for CORS and OAuth redirects
# In production (Railway), set this to your deployed frontend URL
CLIENT_URL=http://localhost:3000

SESSION_SECRET=replace_with_random

# Must be exactly 'production' in deployment: it enables secure/cross-site session
# cookies. Leave as 'development' locally.
NODE_ENV=development

# Reverse-proxy hops to trust. LEAVE THIS UNSET unless you have a specific reason --
# the default of 1 is correct for Railway. It must be a whole number if set; a blank
# or non-numeric value would disable proxy trust, which stops secure session cookies
# from being issued and silently breaks every new login.
# TRUST_PROXY=1

PORT=5000

# Admin "Download full report" button. Set these on the BACKEND service only -
# never on the frontend, whose variables are compiled into the browser bundle.
# The Kotlin report runs as its own Railway service (tutoring-analytics-report)
# in this project; use its PRIVATE networking address, and the same
# REPORT_TOKEN value set on that service. Unset = the button says the report
# service isn't configured.
# REPORT_SERVICE_URL=http://tutoring-analytics-report.railway.internal:8080
# REPORT_TOKEN=replace_with_long_random_string
